{
  // My Future Self: one Worker serves the built app (dist/) and runs code only for /api/* and /prayer-times.json.
  // Nothing here belongs to the Flame SMP store (that is the separate `flame-delivery` Worker).
  "name": "my-future-self",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/prayer-times.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-future-self",
      "database_id": "430afde8-5641-4e76-b6dc-7972cd2f9a28"
    }
  ],
  // Rate limits (per visitor IP, or per account for saves): over the limit -> 429.
  "ratelimits": [
    { "name": "RL_LOGIN", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_API", "namespace_id": "4103", "simple": { "limit": 120, "period": 60 } }
  ],
  // The Google OAuth Client ID is public (no client secret is used).
  "vars": { "GOOGLE_CLIENT_ID": "892050576996-skhemi4r09one5e22oqcceq2ouacm4bp.apps.googleusercontent.com" }
}
